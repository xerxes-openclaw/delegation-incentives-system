# Build artefacts and local state — never belong in the image.
**/node_modules
**/.ponder
**/dist
**/coverage
**/test-results
**/*.tsbuildinfo
*.log

# Secrets. Env comes from the container runtime, not a baked-in file.
.env
.env*.local

.git
.githooks
.vercel

# Dockerfile.web builds the SPA from these, so frontend sources must stay in
# the context. Only its heavy local-only directories are excluded.
apps/frontend/e2e
apps/frontend/playwright.config.ts

# Backend tests aren't run from the image.
apps/backend/test
apps/backend/tests

# Vercel-only serverless functions, and docs.
api
docs
