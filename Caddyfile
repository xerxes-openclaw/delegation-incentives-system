# Public entrypoint. Serves the SPA and proxies the API on a single origin.
#
# APP_DOMAIN must already resolve to this droplet before the first start, or
# certificate issuance fails. Caddy obtains and renews the certificate itself;
# the caddy_data volume in docker-compose.yml is what makes that survive a
# redeploy.
#
# Optional: to get expiry notices from Let's Encrypt, add a global block above
# this one containing `email you@example.com`. It is deliberately omitted --
# an `email` directive with an unset variable fails config parsing and would
# crashloop the proxy.

{$APP_DOMAIN} {
	encode zstd gzip

	# The relayer routes genuinely live at /api/gateful/* on the backend, so
	# this prefix must be forwarded intact. The handle_path below would strip
	# the /api and 404 them. Inert while gasless delegation is off, but kept so
	# that enabling it later does not silently break. Mirrors the special case
	# in the local vite dev proxy.
	handle /api/gateful/* {
		reverse_proxy backend:42069
	}

	# Everything else under /api is the REST API, which the backend serves at
	# its own root — so strip the prefix before forwarding.
	handle_path /api/* {
		reverse_proxy backend:42069
	}

	# The SPA. Unknown paths fall back to index.html so client-side routes such
	# as /voters/0xabc… resolve instead of 404ing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
