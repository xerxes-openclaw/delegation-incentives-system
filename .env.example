DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ens-dis
# Postgres schema holding indexer state. The backend's start script passes this
# to `ponder start --schema`, defaulting to "prod" when unset. Use a distinct
# value per environment (e.g. "staging", "prod") to isolate indexer state.
# Keep it stable across deploys: changing it starts a backfill from scratch.
# DATABASE_SCHEMA=prod
# Mainnet RPC. Accepts a comma-separated list; Ponder spreads load across all of
# them and drops a failing endpoint out of rotation.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Max eth_getLogs window (blocks). Default 1000. Lower it if the backfill logs
# TimeoutError on eth_getLogs; raise it later for speed once past the dense
# 2021-2022 range. Ponder's 10s request timeout is not configurable, so this is
# the only lever for slow providers.
# ETH_GET_LOGS_BLOCK_RANGE=1000
BACKEND_PORT=42069
FRONTEND_PORT=3311
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=false
# Gasless delegation UI. Off unless set to "true". Enable only when the backend
# has the Gateful relayer configured (BLOCKFUL_API_TOKEN + GATEFUL_UPSTREAM_URL);
# with it off the frontend skips all relayer requests and delegates on-chain.
VITE_ENABLE_GASLESS=false
VITE_REOWN_PROJECT_ID=your_reown_project_id
# Local frontend dev only. Required by vite dev when VITE_API_BASE_URL is relative and mocks are disabled.
# Not used by production builds.
VITE_DEV_API_PROXY_TARGET=http://localhost:42069
# Comma-separated YYYY-MM months that are valid distribution rounds.
# If unset, any valid month can be computed.
# ROUND_MONTHS=2026-03,2026-04,2026-05
# Gasless delegation via the Gateful relayer. OPTIONAL — leave both unset to run
# without a relayer, in which case the proxy routes are never mounted and the
# frontend delegates with a direct on-chain delegate(address) call paid by the user.
# Set BOTH to enable it; setting only one fails startup validation.
# BLOCKFUL_API_TOKEN=
# GATEFUL_UPSTREAM_URL=https://gateful.example.com
# Test-only override for the upstream relayer timeout (ms). Leave unset in production.
# GATEFUL_UPSTREAM_TIMEOUT_MS=15000
# Comma-separated frontend origins permitted to call this backend cross-origin.
# NOT needed for the standard docker-compose deployment: Caddy serves the SPA and
# proxies the API on one origin, so requests are same-origin and CORS never applies.
# Only set this if you host the frontend somewhere else (e.g. Vercel).
# ALLOWED_ORIGINS=https://yourapp.example.com,https://staging.yourapp.example.com

# ─── Deployment (docker compose) ────────────────────────────────────────────
# Public hostname serving both the SPA and the API. Must already resolve to this
# host before the first start, or Caddy's certificate issuance fails.
# APP_DOMAIN=app.example.com
#
# Note: VITE_* values above are compiled into the JS bundle at build time, not
# read at runtime. docker-compose.yml passes VITE_REOWN_PROJECT_ID through as a
# build arg, so changing it requires `docker compose up -d --build caddy`.
