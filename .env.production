# Production build-time config for the frontend.
# vite.config reads env from the repo ROOT via loadEnv(mode, rootDir), so this
# file (NOT apps/frontend/.env.*) is what a production build picks up.
#
# The Railway backend holds the indexed round/tier data and sends
# access-control-allow-origin: *, so the SPA calls it cross-origin directly.
# Pointing at it here is what makes the APY/tier numbers real (vs an empty
# self-hosted backend, which shows base defaults like 2.9% / tier 1 / +0.00%).
VITE_API_BASE_URL=https://ens-incentives-server-production.up.railway.app
VITE_USE_MOCK_API=false
VITE_REOWN_PROJECT_ID=ree1d4f13ca7acd12d1182942a03224b6
